# Prod environment (non-secret)
ENV_NAME=prod
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=rg-samplecicd-prod
AZURE_ACR_NAME=samplecicdprodacr
AZURE_ACR_SKU=Basic
AZURE_APP_PLAN=samplecicd-prod-plan
AZURE_APP_PLAN_SKU=B1
AZURE_BACKEND_APP=samplecicd-backend-prod
AZURE_FRONTEND_APP=samplecicd-frontend-prod
AZURE_REDIS_NAME=samplecicd-redis-prod
AZURE_REDIS_SKU=Basic
AZURE_REDIS_FAMILY=C
AZURE_REDIS_CAPACITY=0
AZURE_REDIS_PORT=6379
AZURE_REDIS_DB=0
AZURE_CONTAINERAPPS_ENV=cae-samplecicd-prod
AZURE_CONTAINERAPPS_WORKER=samplecicd-worker-prod
AZURE_CONTAINERAPPS_FLOWER=samplecicd-flower-prod
AZURE_CONTAINERAPPS_PROFILE=Consumption
IMAGE_TAG=prod-latest
