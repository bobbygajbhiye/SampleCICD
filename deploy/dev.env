# Dev environment (non-secret)
ENV_NAME=dev
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=rg-samplecicd-dev
AZURE_ACR_NAME=samplecicddevacr
AZURE_ACR_SKU=Basic
AZURE_APP_PLAN=samplecicd-dev-plan
AZURE_APP_PLAN_SKU=B1
AZURE_BACKEND_APP=samplecicd-backend-dev
AZURE_FRONTEND_APP=samplecicd-frontend-dev
AZURE_REDIS_NAME=samplecicd-redis-dev
AZURE_REDIS_SKU=Basic
AZURE_REDIS_FAMILY=C
AZURE_REDIS_CAPACITY=0
AZURE_REDIS_PORT=6379
AZURE_REDIS_DB=0
AZURE_CONTAINERAPPS_ENV=cae-samplecicd-dev
AZURE_CONTAINERAPPS_WORKER=samplecicd-worker-dev
AZURE_CONTAINERAPPS_FLOWER=samplecicd-flower-dev
AZURE_CONTAINERAPPS_PROFILE=Consumption
IMAGE_TAG=dev-latest
